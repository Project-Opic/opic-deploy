{
 "annotations": {
  "list": []
 },
 "title": "OPIC 技术底座 · 应用监控（techbase）",
 "uid": "opic-techbase-app",
 "tags": [
  "opic",
  "techbase"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "panels": [
  {
   "id": 100,
   "title": "应用状态 up",
   "type": "stat",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 3
   },
   "datasource": {
    "type": "prometheus",
    "uid": "ds-prometheus"
   },
   "targets": [
    {
     "expr": "up{job=\"techbase\"}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "UP",
         "color": "green"
        },
        "0": {
         "text": "DOWN",
         "color": "red"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none"
   }
  },
  {
   "id": 2,
   "title": "QPS（按状态）",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 3,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "ds-prometheus"
   },
   "targets": [
    {
     "expr": "sum(rate(opic_techbase_http_requests_total[1m]))",
     "refId": "A"
    },
    {
     "expr": "sum(rate(opic_techbase_http_requests_total{status=~\"5..\"}[1m]))",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 3,
   "title": "5xx 错误率（%）",
   "type": "timeseries",
   "gridPos": {
    "x": 12,
    "y": 3,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "ds-prometheus"
   },
   "targets": [
    {
     "expr": "100 * sum(rate(opic_techbase_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(opic_techbase_http_requests_total[5m])), 0.001)",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 4,
   "title": "P95 请求延迟（秒）",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 11,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "ds-prometheus"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum(rate(opic_techbase_http_request_duration_seconds_bucket[5m])) by (le))",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 5,
   "title": "Goroutines / 常驻内存",
   "type": "timeseries",
   "gridPos": {
    "x": 12,
    "y": 11,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "ds-prometheus"
   },
   "targets": [
    {
     "expr": "opic_techbase_go_goroutines",
     "refId": "A"
    },
    {
     "expr": "opic_techbase_process_resident_memory_bytes",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 6,
   "title": "DB 连接池",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 19,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "ds-prometheus"
   },
   "targets": [
    {
     "expr": "opic_techbase_db_pool_open_connections",
     "refId": "A"
    },
    {
     "expr": "opic_techbase_db_pool_idle_connections",
     "refId": "B"
    },
    {
     "expr": "opic_techbase_db_pool_in_use_connections",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  }
 ]
}