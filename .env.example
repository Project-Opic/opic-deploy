# ==============================================================================
# opic-deploy — 统一配置源
# ==============================================================================
# 用法:  cp .env.example .env  &&  vim .env
#
# 本文件是**唯一配置源**：stacks/ 下的 compose 文件与脚本一律从这里取值。
# 纪律：只保留**真正生效**的开关。任何"配了不生效"的变量都必须删掉，
#       否则会在交付现场制造假安全感（历史教训：域名切换后前端常量未同步）。
# ==============================================================================

# ── 全局 ──────────────────────────────────────────────────────────────────────
BASE_DOMAIN=opic.example.com
TZ=Asia/Shanghai
IMAGE_PREFIX=
# 与其余 stack 共用的外部 Docker 网络（须已存在：docker network create opic-net）
DOCKER_NETWORK=opic-net

# ── NATS · 事件总线传输层（对应 O-SYS 事件总线，第 3 层实现）────────────────────
NATS_IMAGE=nats
NATS_IMAGE_TAG=2.14-alpine
# 客户端鉴权（必填）。注意：口令只存在于 .env，不写进 configs/ 下的配置文件。
NATS_USER=opic
NATS_PASSWORD=
# 宿主端口映射（容器内端口固定 4222 / 8222）
NATS_CLIENT_PORT=4222
NATS_MONITOR_PORT=8222
# JetStream 数据落盘（建议 NVMe 或本地 SSD；NFS 会显著拖慢投递）
NATS_DATA_DIR=/opt/opic/nats/data

# ── Temporal · 流程引擎运行（对应 O-SYS 流程引擎运行承载，第 3 层实现）──────────
# ⚠ auto-setup 上游最高只到 1.29.x（temporalio/docker-compose 已归档，无 1.30+ 镜像）
# ⚠ admin-tools 无 1.29.0 镜像，默认 1.30.4 CLI 对 1.29 server（gRPC 向后兼容）
TEMPORAL_IMAGE=temporalio/auto-setup
TEMPORAL_IMAGE_TAG=1.29.0
TEMPORAL_UI_IMAGE=temporalio/ui
TEMPORAL_UI_IMAGE_TAG=2.34.0
TEMPORAL_ADMINTOOLS_IMAGE=temporalio/admin-tools
TEMPORAL_ADMINTOOLS_IMAGE_TAG=1.30.4
TEMPORAL_PG_IMAGE=postgres
TEMPORAL_PG_IMAGE_TAG=16-alpine
# 宿主端口映射（容器内 gRPC 固定 7233、UI 固定 8080）
TEMPORAL_GRPC_PORT=7233
TEMPORAL_UI_PORT=8233
# 持久化（复用 OPIC 统一 PostgreSQL 16 口径；本 stack 自带一个实例，便于独立起停）
TEMPORAL_PG_DB=temporal
TEMPORAL_PG_USER=temporal
TEMPORAL_PG_PASSWORD=
TEMPORAL_PG_DATA_DIR=/opt/opic/temporal/pgdata
# 业务命名空间：default 之外为 OPIC 业务单独建一个（见 stacks/temporal/post-install.sh）
TEMPORAL_NAMESPACE=opic
# 已完成工作流历史的保留天数（对应 O-SYS 审计留痕的可回溯窗口）
TEMPORAL_RETENTION_DAYS=30
# Web UI 允许的跨域来源（浏览器访问 UI 的地址）
TEMPORAL_UI_PUBLIC_URL=http://localhost:8233

# ── 统一 PostgreSQL · 数据基座（stacks/database，opicdb 统一口径）────────────────
OPIC_PG_IMAGE=postgres
OPIC_PG_IMAGE_TAG=16-alpine
# 超级管理员口令（ZITADEL 的 ADMIN 连接也用它；必填）
PG_ADMIN_PASSWORD=
# 数据落盘（建议 NVMe 或本地 SSD）
DATABASE_PG_DATA_DIR=/opt/opic/database/pgdata
# 排障端口（默认仅绑回环固定口；纯容器网络访问可注释 compose 的 ports 段）
DATABASE_PG_PORT=

# ── Redis · 缓存（stacks/redis，数据面；应用面经 opic-net 访问）─────────────────
REDIS_IMAGE=redis
REDIS_IMAGE_TAG=8.10.2-alpine
REDIS_PASSWORD=
REDIS_DATA_DIR=/opt/opic/redis/data
# 排障端口（默认仅绑回环固定口；纯容器网络访问可注释 compose 的 ports 段）
REDIS_PORT=

# ── Traefik · 入口网关（stacks/traefik，壳先起、路由随栈自动发现）────────────────
TRAEFIK_IMAGE=traefik
TRAEFIK_IMAGE_TAG=v3.7.10
TRAEFIK_WEB_PORT=80
TRAEFIK_WEBSECURE_PORT=443
TRAEFIK_DASHBOARD_PORT=8088
# DEV 实测（192.168.3.200，80/443/8080 被宿主 nginx 与 kube-router 占用）：
#   TRAEFIK_WEB_PORT=18880  TRAEFIK_WEBSECURE_PORT=19443  TRAEFIK_DASHBOARD_PORT=18887

# ── ZITADEL · 零信任 IdP（stacks/zero-trust，运维侧）──────────────────────────
ZITADEL_IMAGE=zitadel/zitadel
ZITADEL_LOGIN_IMAGE=zitadel/zitadel-login
ZITADEL_IMAGE_TAG=4.19.3
# masterkey：恰好 32 字符，用于加密密钥库。**丢失即无法解密既有数据**，必须随 .env 备份
ZITADEL_MASTERKEY=
# 数据库账号（由 stacks/database 的 init 脚本建好）
ZITADEL_DB_PASSWORD=
# 首个组织的 admin 人类用户口令（默认账号 zitadel-admin@zitadel.localhost）
# ⚠ 必须满足复杂度：大写+小写+数字+符号（gen-env.sh 生成的 Op1- 前缀格式已合规）
ZITADEL_ADMIN_PASSWORD=
# 对外域名与端口：必须与浏览器地址栏一致（OIDC issuer 由它构成）
#   DEV 实测：ZITADEL_DOMAIN=auth.192.168.3.200.nip.io  ZITADEL_EXTERNALPORT=18880
ZITADEL_DOMAIN=localhost
ZITADEL_EXTERNALPORT=80
# 直连排障端口（绕过网关的 break-glass 入口；生产建议置空）
ZITADEL_API_PORT=18082

# login-client PAT 过期时间（Login UI 的 API 凭据，官方 v4 范式）
LOGIN_CLIENT_PAT_EXPIRATION=2099-01-01T00:00:00Z
# Login UI 会话 cookie 签名密钥
LOGIN_SESSION_COOKIE_SECRET=

# ── Casdoor · IdP（stacks/casdoor，租户侧）────────────────────────────────────
CASDOOR_IMAGE=casbin/casdoor
# casdoor 无可核验的版本 tag 源，默认 latest；首次部署后用 `docker image ls casbin/casdoor`
# 记录实际版本并在此回填锁定
CASDOOR_IMAGE_TAG=latest
CASDOOR_DB_PASSWORD=
CASDOOR_HTTP_PORT=8000
# DEV 实测：18000 被宿主 ocai-service 占用 → 用 18001

# ── Harbor · 镜像仓库（stacks/registry，由官方安装器自管 compose）───────────────
HARBOR_VERSION=v2.15.2
HARBOR_HOSTNAME=192.168.3.200
HARBOR_HTTP_PORT=18700
HARBOR_ADMIN_PASSWORD=
HARBOR_DB_PASSWORD=
HARBOR_DATA_DIR=/opt/opic/harbor/data
# 离线安装包放置目录（能访问 GitHub 时自动在线下载，否则放此目录）
HARBOR_PACKAGE_DIR=packages
# 已解压安装器目录（离线环境推荐；只拷贝使用，不动原目录）
HARBOR_INSTALLER_DIR=
