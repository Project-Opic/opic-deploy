[Unit]
Description=etcd {{ etcd_version }} (OPIC DCS for Patroni)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart={{ etcd_bin_dir }}/etcd \
  --name {{ ansible_hostname }} \
  --data-dir {{ etcd_data_dir }} \
  --listen-client-urls https://0.0.0.0:{{ etcd_client_port }} \
  --advertise-client-urls https://{{ ansible_host }}:{{ etcd_client_port }} \
  --listen-peer-urls https://0.0.0.0:{{ etcd_peer_port }} \
  --initial-advertise-peer-urls https://{{ ansible_host }}:{{ etcd_peer_port }} \
  --initial-cluster {% for h in groups['etcd_cluster'] %}{{ h }}=https://{{ hostvars[h].ansible_host }}:{{ etcd_peer_port }}{% if not loop.last %},{% endif %}{% endfor %} \
  --initial-cluster-token {{ etcd_cluster_token }} \
  --initial-cluster-state new \
  --cert-file {{ etcd_ssl_dir }}/etcd.pem \
  --key-file {{ etcd_ssl_dir }}/etcd-key.pem \
  --trusted-ca-file {{ etcd_ssl_dir }}/ca.crt \
  --client-cert-auth \
  --peer-cert-file {{ etcd_ssl_dir }}/etcd.pem \
  --peer-key-file {{ etcd_ssl_dir }}/etcd-key.pem \
  --peer-trusted-ca-file {{ etcd_ssl_dir }}/ca.crt \
  --peer-client-cert-auth \
  --auto-compaction-retention 24
Restart=on-failure
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
