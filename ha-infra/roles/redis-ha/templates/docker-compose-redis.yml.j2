# Redis 7 + Sentinel ×{{ redis_replicas | default(3) }}
version: "3.8"
services:
  redis:
    image: "{{ redis_image }}"
    container_name: redis-{{ ansible_hostname }}
    network_mode: host
    restart: unless-stopped
    command: redis-server /usr/local/etc/redis/redis.conf
    volumes:
      - "{{ redis_data_dir }}:/data"
      - "{{ opic_ha_stack }}/redis/redis.conf:/usr/local/etc/redis/redis.conf:ro"
  sentinel:
    image: "{{ redis_image }}"
    container_name: sentinel-{{ ansible_hostname }}
    network_mode: host
    restart: unless-stopped
    command: redis-sentinel /usr/local/etc/redis/sentinel.conf
    volumes:
      - "{{ redis_data_dir }}/sentinel:/data"
      - "{{ opic_ha_stack }}/redis/sentinel.conf:/usr/local/etc/redis/sentinel.conf"
    depends_on:
      - redis
