MINIO_ROOT_USER={{ minio_root_user }}
MINIO_ROOT_PASSWORD={{ minio_root_password }}
MINIO_VOLUMES="{% for h in groups['minio_cluster'] %}http://{{ hostvars[h].ansible_host }}/data/minio/{1...4} {% endfor %}"
MINIO_OPTS="--address :{{ minio_api_port }} --console-address :{{ minio_console_port }}"
# metrics 端点不支持 Basic/Prometheus sigv4（400）；lab 内网放开匿名抓取
MINIO_PROMETHEUS_AUTH_TYPE=public
