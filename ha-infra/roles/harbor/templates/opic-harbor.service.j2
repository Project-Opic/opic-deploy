[Unit]
Description=OPIC Harbor (compose-managed, P2.1 restart=no)
After=docker.service {{ 'nfs-client.target' if harbor_data_volume != '/opt/opic/harbor/data' else '' }}
Requires=docker.service
Wants=nfs-client.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ harbor_installer_dir }}/harbor
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
