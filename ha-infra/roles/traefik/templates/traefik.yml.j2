# Traefik v3 static config（host network + file provider，通配证书本地签发）
global:
  checkNewVersion: false
  sendAnonymousUsage: false

entryPoints:
  websecure:
    address: ":{{ port_map.traefik_tls }}"

providers:
  file:
    directory: "/etc/traefik/dynamic"
    watch: true

api:
  dashboard: false

log:
  level: INFO

tls:
  options:
    default:
      minVersion: VersionTLS12
# 注意：v3 静态配置 tls: 只支持 options；证书必须放 dynamic/ 目录（见 dynamic tls.yml）

serversTransport:
  rootCAs:
    - /etc/traefik/tls/ca.crt
