# Harbor route — file provider（registry.<domain> :443 → 三台 Harbor TLS :18700）
http:
  routers:
    harbor:
      rule: "Host(`registry.{{ opic_base_domain }}`)"
      entryPoints: [websecure]
      service: harbor-svc
      tls: {}
  services:
    harbor-svc:
      loadBalancer:
        passHostHeader: true
        servers:
{% for h in groups['harbor'] %}
          - url: "https://{{ hostvars[h].ansible_host }}:{{ harbor_tls_port | default(18700) }}"
{% endfor %}
        healthCheck:
          path: /api/v2.0/health
          method: GET
          scheme: https
          interval: 10s
          timeout: 5s
