services:
  nats:
    image: {{ nats_image }}
    container_name: opic-nats
    restart: no
    network_mode: host
    command: -config /etc/nats/nats-server.conf
    volumes:
      - {{ nats_dir }}/nats-server.conf:/etc/nats/nats-server.conf:ro
      - {{ nats_data }}:/data
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:{{ nats_monitor_port }}/healthz"]
      interval: 15s
      timeout: 5s
      retries: 5
