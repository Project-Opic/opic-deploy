# NATS JetStream 3-node cluster (host network)
server_name: nats-{{ ansible_hostname }}
port: {{ nats_client_port }}
cluster {
  name: opic-nats
  port: {{ nats_cluster_port }}
  routes = [
{% for h in groups['nats_cluster'] | default(groups['pg_cluster']) %}
    nats-route://{{ hostvars[h].ansible_host }}:{{ nats_cluster_port }}
{% endfor %}
  ]
}
jetstream {
  store_dir: /data
  max_file_store: 10GB
}
# nats-server 2.10 无内置 Prometheus 端点（http: 只出 varz/routez 等 JSON；
# block 形式不被解析）。指标由 prometheus-nats-exporter 消费 monitor JSON 输出。
http: {{ nats_monitor_port }}
